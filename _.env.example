# ---------- Telegram ----------
API_ID=1234567
API_HASH=your_api_hash
BOT_TOKEN=123456:ABC-your-bot-token
# Only these Telegram user IDs can use the bot (comma separated)
OWNER_IDS=123456789

# ---------- TeraBox (email + password login, auto re-login) ----------
# Use an account that has an email+password (Google/Apple-only accounts: set a password first)
TERABOX_EMAIL=
TERABOX_PASSWORD=
TERABOX_REMOTE_DIR=/TelegramBot

# ---------- Google Drive (optional, choose ONE credential method) ----------
# A) OAuth (works for uploading to your personal My Drive)
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
# B) Service account JSON, minified to ONE line (download + Shared Drive upload)
GDRIVE_SERVICE_ACCOUNT_JSON=
# Destination folder ID for "Send to Drive"
GDRIVE_FOLDER_ID=

# ---------- MEGA via rclone (optional) ----------
MEGA_USER=
MEGA_PASS=
MEGA_DIR=/TelegramBot

# ---------- System (Render sets PORT and RENDER_EXTERNAL_URL itself) ----------
DOWNLOAD_DIR=/tmp/downloads
PORT=10000
